{
  "name": "schoolees/laravel-psgc",
  "description": "PSGC for Laravel: migrations, seeders, JSON data, models, services, resources, controllers, and read-only routes.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/pagination": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/filesystem": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "symfony/http-kernel": "^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Schoolees\\Psgc\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Schoolees\\Psgc\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.x-dev"
    },
    "laravel": {
      "providers": [
        "Schoolees\\Psgc\\Providers\\PsgcServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
